# C++
**/cmake-build*/
**/build*/
**/*.so
**/*.log*

# Omniverse
**/*.dmp
**/.thumbs

# No USD files allowed in the repo
**/*.usd
**/*.usda
**/*.usdc
**/*.usdz
# Exception: the Trossen spatula-lift task vendors its (LFS-tracked) scene assets so a
# plain git pull is the entire setup -- no fetch scripts, no external asset clone.
!source/isaaclab_tasks/isaaclab_tasks/contrib/trossen_spatula_lift/assets/usd/*.usd
!source/isaaclab_tasks/isaaclab_tasks/contrib/trossen_spatula_lift/assets/usd/*.usda

# Python
.DS_Store
**/*.egg-info/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/*.pb

# Docker/Singularity
**/*.sif
docker/cluster/exports/
docker/.container.cfg

# IDE
**/.idea/
**/.vscode/
# Don't ignore the top-level .vscode directory as it is
# used to configure VS Code settings
!.vscode

# Outputs
**/output/*
**/outputs/*
**/videos/*
**/wandb/*
**/.neptune/*
docker/artifacts/
*.tmp
**/__tracked_surface.stl

# Doc Outputs
**/docs/_build/*
**/generated/*

# Isaac-Sim packman
_isaac_sim*
_repo
_build
.lastformat

# RL-Games
**/runs/*
**/logs/*
**/recordings/*

# Pre-Trained Checkpoints
/.pretrained_checkpoints/

# Teleop Recorded Dataset
/datasets/

# Tests
/tests/

# Docker history
.isaac-lab-docker-history

# TacSL sensor
**/tactile_record/*
**/gelsight_r15_data/*

# No benchmarks output
/benchmarks/
scripts/benchmarks/dt_floor_results.jsonl

# Ruff cache
**/.ruff_cache/

# Isaac Lab CI environments in native mode
**/_isaaclab_install_ci_*

# Superpowers (Claude Code plugin artifacts)
docs/superpowers/
nohup.out
